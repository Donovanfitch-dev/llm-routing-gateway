{
  "schemaVersion": 1,
  "name": "candidate-cost-saver",
  "description": "Proposed change: weight cost more heavily, route vision work only to boreal, raise the code-review quality floor, and reject over-budget requests instead of downgrading them.",
  "weights": { "cost": 0.65, "quality": 0.2, "latency": 0.15 },
  "fallbackDepth": 2,
  "distinctProviderFallbacks": true,
  "deny": [
    {
      "id": "deny-cirrus-for-tenant-beta",
      "reason": "fictional contractual restriction: tenant-beta may not use cirrus",
      "match": { "provider": "cirrus", "tenantId": "tenant-beta" }
    },
    {
      "id": "deny-boreal-mini-for-extraction",
      "reason": "fictional evaluation finding: unreliable structured extraction",
      "match": { "model": "boreal-mini", "taskClass": "extract-json" }
    }
  ],
  "taskOverrides": {
    "code-review": {
      "weights": { "cost": 0.1, "quality": 0.8, "latency": 0.1 },
      "minQualityTier": 5
    },
    "classify": {
      "weights": { "cost": 0.8, "quality": 0.05, "latency": 0.15 }
    },
    "extract-json": {
      "minQualityTier": 3
    },
    "vision-describe": {
      "minQualityTier": 3,
      "allowProviders": ["boreal"]
    }
  },
  "budget": {
    "windowSeconds": 86400,
    "defaultLimitUsd": 1.0,
    "tenantLimitsUsd": { "tenant-gamma": 0.05 },
    "onExceed": "reject"
  },
  "breaker": {
    "failureThreshold": 3,
    "openDurationMs": 300000,
    "halfOpenMaxProbes": 1
  }
}
